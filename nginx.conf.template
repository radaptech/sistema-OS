server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Prévia de link (WhatsApp, Slack): o index.html traz __ORIGEM__ como placeholder
    # nas tags og: (ver index.html). og:image PRECISA ser URL absoluta -- WhatsApp
    # ignora caminho relativo -- e o host não pode ser fixo no HTML: cada tenant tem o
    # seu subdomínio e um deploy só serve todos eles. Então quem resolve é o nginx, em
    # runtime, com o $host da própria requisição. sub_filter só age em text/html
    # (padrão de sub_filter_types), ou seja, não encosta no bundle .js.
    sub_filter '__ORIGEM__' 'https://$host';
    sub_filter_once off;

    # PWA: o que decide "tem versão nova" nunca pode vir de cache. sw.js e manifest
    # sempre revalidam (no-cache = pode guardar, mas pergunta ao servidor antes de usar);
    # index.html idem, senão o app instalado abriria o HTML velho apontando pra assets
    # velhos. Os /assets/ têm hash no nome -- mudou o conteúdo, mudou o nome --, então
    # podem ficar em cache pra sempre.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        default_type application/manifest+json;
        try_files $uri =404;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA: React Router decide a rota no cliente, então qualquer caminho que
    # não bate em arquivo estático (ex: /painel-administrador, F5 numa rota
    # interna) precisa cair no index.html -- sem isso o nginx responde 404
    # pra tudo que não for a raiz.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
