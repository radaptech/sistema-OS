# URL base da API de back-end.
# Se omitido o protocolo, o api.ts assume "https://" automaticamente.
# Se a variável não for definida, o api.ts utiliza a URL de homologação como fallback.
#
# ⚠️ Front e API precisam ficar sob o MESMO domínio registrável
# (*.radaptech.com.br nos dois). O cookie de sessão é HttpOnly + SameSite=Lax:
# em domínios registráveis diferentes o login responde 200 e o navegador
# DESCARTA o cookie -- o usuário volta pro login em loop, sem erro visível. O
# CORS do back (middleware/cors.go) também só libera localhost e radaptech.com.br.
#
# Em dev o compose sobrescreve isto com "/api" (mesma origem, atrás do traefik).
REACT_APP_URL_API=https://api.radaptech.com.br

# Modo mock (ver CLAUDE.md e src/mocks/): "true" troca toda chamada de api.ts por dados
# simulados em memória (src/mocks/apiMock.ts), sem precisar de back-end no ar. "false" (ou
# ausente) usa a API real configurada acima. Credenciais de demonstração em
# src/mocks/bancoMock.ts (ex: solicitante@demo.com / 123456).
VITE_USE_MOCKS=true
